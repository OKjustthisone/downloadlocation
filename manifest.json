{
  "manifest_version": 3,
  "name": "LocationDL — 下载位置路由",
  "short_name": "LocationDL",
  "version": "1.0.0",
  "description": "按域名/URL、文件名关键词和扩展名规则，自动将下载文件保存到“下载”目录下的指定子文件夹。",
  "minimum_chrome_version": "109",
  "permissions": [
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "LocationDL 下载位置路由",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
